# ==============================================================================
# Rang & Riwaayat — Environment Configuration
# ==============================================================================

# Node & Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Canonical Site URL (set to your Vercel or Render production domain, e.g. https://rangriwaayat.in)
NEXT_PUBLIC_SITE_URL=https://rangriwaayat.in

# Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rang_riwaayat?retryWrites=true&w=majority
# Fallback to local high-speed in-memory verified seeds when database is connecting
USE_FILE_DATA_STORE_FALLBACK=true

# Security & Admin Authentication
ADMIN_JWT_SECRET=rang-and-riwaayat-production-jwt-secret-replace-with-64-char-random-string
ADMIN_SESSION_MAX_AGE_DAYS=7

# Initial Admin Credentials (used during seed/bootstrap)
INITIAL_ADMIN_EMAIL=admin@rangriwaayat.in
INITIAL_ADMIN_NAME="Chief Cultural Editor"
INITIAL_ADMIN_PASSWORD=Riwaayat@2026SecureAdmin

# ==============================================================================
# Google AdSense Monetization
# ==============================================================================
# Set to true once your AdSense account is approved and ready to display live ads
NEXT_PUBLIC_ADS_ENABLED=false

# Your 16-digit AdSense Client ID (e.g. ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-0000000000000000

# Your AdSense Publisher ID for ads.txt (e.g. pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_PUB_ID=pub-0000000000000000

# Optional Google Analytics 4 Measurement ID
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# ==============================================================================
# Realtime Multiplayer Socket.IO
# ==============================================================================
# On Render / Node.js servers, leave blank or set to origin
# On Vercel (if pointing multiplayer to a dedicated Render backend):
# NEXT_PUBLIC_SOCKET_URL=https://rang-and-riwaayat.onrender.com
NEXT_PUBLIC_SOCKET_URL=
